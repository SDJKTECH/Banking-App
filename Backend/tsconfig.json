{
  "compilerOptions": {
    /* Target & Environment */
    "target": "ES2022",                        /* Use modern JavaScript features */
    "module": "NodeNext",                      /* Best for native ESM or CommonJS */
    "moduleResolution": "NodeNext",            /* Matches Node.js module resolution strategy */
    "lib": ["ES2022"],                         /* Include modern JS language definitions */

    /* Output Settings */
    "outDir": "./dist",                        /* Redirect output structure to the directory */
    "rootDir": "./src",                        /* Specify the root directory of input files */
    "sourceMap": true,                         /* Create mesh files for debugging */

    /* Strictness & Safety */
    "strict": true,                            /* Enable all strict type-checking options */
    "noImplicitAny": true,                     /* Raise error on expressions and declarations with an implied 'any' type */
    "strictNullChecks": true,                  /* Enable strict null checks */

    /* Interoperability & Clean Up */
    "esModuleInterop": true,                   /* Emit additional JavaScript to ease support for importing CommonJS modules */
    "forceConsistentCasingInFileNames": true,  /* Ensure that casing is correct in imports */
    "skipLibCheck": true,                       /* Skip type checking of declaration files (.d.ts) */
    "types":["node"]
  },
  "include": ["src/**/*"],                     /* Include all files inside the src directory */
  "exclude": ["node_modules", "dist"]          /* Ignore dependencies and build outputs */
}
